# Generated by the One-Click Microsite Builder. Cloudflare Pages ignores this file.
Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
RewriteEngine On

# Retired /laptop landing page
RewriteRule ^laptop/?$ /desktop-and-laptop-repair [R=301,L]

# Old misspelled Lansdowne URL
RewriteRule ^computer-repair-in-landsdowne-va(\.html)?$ /computer-repair-in-lansdowne-va [R=301,L]

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# /about.html -> /about
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /about -> serve about.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
