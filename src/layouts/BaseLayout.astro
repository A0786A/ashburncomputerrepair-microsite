---
import { business } from "../config.ts";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  // Path relative to the site root, e.g. "/laptop-repair"
  path?: string;
  // One JSON-LD object (or array of them) rendered as application/ld+json
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, path = "/", jsonLd } = Astro.props;
const canonical = new URL(path, business.siteUrl).toString();
const fullTitle = `${title} | ${business.name} — ${business.city}`;
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const nameParts = business.name.split(" ");
const brandMain = nameParts.slice(0, 2).join(" ");
const brandRest = nameParts.slice(2).join(" ");
const ogImage = `${business.siteUrl}/images/team-front-desk.webp`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="google-site-verification"
      content="bM1F6x5CLDtLhq8zdu_2KwQEWo6pOOsxbG3eGHHuG7M"
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="apple-touch-icon" href="/images/logo.png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {
      jsonLdList.map((item) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(item)}
        />
      ))
    }
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">
          <img
            class="brand-logo"
            src="/images/logo.webp"
            alt=""
            width="512"
            height="512"
          />
          <span class="brand-name">{brandMain} <span>{brandRest}</span></span>
        </a>
        <nav class="main" aria-label="Main">
          <a href="/computer-repair">Computer Repair</a>
          <a href="/laptop-repair">Laptop Repair</a>
          <a href="/virus-removal">Virus Removal</a>
          <a href="/data-recovery">Data Recovery</a>
          <a href="/phone-repair">Phone Repair</a>
          <a href="/gaming-console-repair">Console Repair</a>
          <a href="/faq">FAQ</a>
          <a href="/contact">Contact</a>
          <a class="call" href={`tel:${business.phone}`}>
            Call {business.phoneDisplay}
          </a>
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="wrap">
        <img
          class="footer-logo"
          src="/images/logo.webp"
          alt="AZ Tech Services logo"
          width="512"
          height="512"
        />
        <p>
          {business.name} — computer, laptop, phone, and gaming console repair
          serving {business.city} and nearby towns.
        </p>
        <p>
          {business.fullAddress} ·{" "}
          <a href={`tel:${business.phone}`}>{business.phoneDisplay}</a> ·{" "}
          {business.hoursDisplay}
        </p>
        <p>
          <a href="/">Home</a> · <a href="/faq">FAQ</a> ·{" "}
          <a href="/contact">Contact</a>
        </p>
      </div>
    </footer>
  </body>
</html>
