        loading="lazy"
      />
      <figcaption>Mini PC repairs</figcaption>
    </figure>
    <figure>
      <img
        src="/images/team-logo-wall.jpg"
        alt="Team member at the AZ Tech Services counter in Ashburn, VA"
        width="1320"
        height="903"
        loading="lazy"
      />
      <figcaption>At the counter</figcaption>
    </figure>
    <figure>
      <img
        src="/images/techs-bench.jpg"
