---
import BaseLayout from "../layouts/BaseLayout.astro";
import { business, serviceAreaText } from "../config.ts";

const localBusiness = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: business.name,
  url: business.siteUrl,
  telephone: business.phone,
  address: {
    "@type": "PostalAddress",
    streetAddress: business.streetAddress,
    addressLocality: business.addressLocality,
    addressRegion: business.addressRegion,
    postalCode: business.postalCode,
    addressCountry: "US",
  },
  openingHours: business.openingHours,
  image: `${business.siteUrl}/images/team-front-desk.jpg`,
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.9",
    reviewCount: "169",
  },
  sameAs: ["https://www.aztechservices.net"],
  areaServed: business.serviceArea.map((place) => ({
    "@type": "City",
    name: place,
  })),
};
---

<BaseLayout
  title="Computer, Laptop & Phone Repair in Ashburn, VA"
  description="Fast, local computer repair in Ashburn, VA — desktops, laptops, virus removal, data recovery, phones, and gaming consoles. Free quotes and walk-ins welcome."
  path="/"
  jsonLd={localBusiness}
>
  <section class="hero">
    <h1>Computer Repair in Ashburn, VA</h1>
    <img
      class="hero-img"
      src="/images/team-front-desk.jpg"
      alt="The AZ Tech Services team at the front desk of the Ashburn shop"
      width="1320"
      height="990"
      fetchpriority="high"
    />
    <p class="lede">
      Broken laptop, slow PC, virus, or lost files? {business.name} fixes
      computers for people and businesses in Ashburn — with free quotes, clear
      pricing before any work starts, and no fix, no fuss.
    </p>
    <p>
      Walk in with your device or <a href="/contact">get in touch</a> and we
      will tell you what is wrong, what it costs, and how long it takes —
      before you commit to anything.
    </p>
    <p class="rating">★ 4.9 · 169 Google reviews</p>
    <p class="cta-row">
      <a class="btn btn-primary" href={`tel:${business.phone}`}>
        Call {business.phoneDisplay}
      </a>
      <a class="btn btn-outline" href="/contact">Get a free quote</a>
    </p>
  </section>

  <h2>What we fix</h2>
  <div class="cards">
    <div class="card">
      <h3><a href="/computer-repair">Computer Repair</a></h3>
      <p>
        Desktop PCs that will not boot, crash, overheat, or have stopped
        keeping up.
      </p>
    </div>
    <div class="card">
      <h3><a href="/laptop-repair">Laptop Repair</a></h3>
      <p>
        Cracked screens, dead batteries, broken keyboards, charging ports, and
        hinge damage.
      </p>
    </div>
    <div class="card">
      <h3><a href="/virus-removal">Virus Removal</a></h3>
      <p>
        Pop-ups, ransomware scares, browser hijacks, and malware cleaned out
        properly.
      </p>
    </div>
    <div class="card">
      <h3><a href="/data-recovery">Data Recovery</a></h3>
      <p>
        Photos, documents, and work files recovered from failing drives and
        dead devices.
      </p>
    </div>
    <div class="card">
      <h3><a href="/phone-repair">Phone Repair</a></h3>
      <p>Screen, battery, and charging repairs for popular phones.</p>
    </div>
    <div class="card">
      <h3><a href="/gaming-console-repair">Console Repair</a></h3>
      <p>
        PlayStation, Xbox, and Nintendo consoles — HDMI, disc drive, and
        overheating problems.
      </p>
    </div>
  </div>

  <h2>Areas we serve</h2>
  <p>
    Based in Ashburn, we repair devices for customers across {serviceAreaText}.
  </p>

  <h2>Inside the shop</h2>
  <div class="gallery">
    <figure>
      <img
        src="/images/bench.jpg"
        alt="Technicians repairing a laptop at the AZ Tech Services workbench in Ashburn, VA"
        width="1400"
        height="1050"
        loading="lazy"
      />
      <figcaption>Our repair bench in Ashburn</figcaption>
    </figure>
    <figure>
      <img
        src="/images/server-rack.jpg"
        alt="Server and network rack installed by AZ Tech Services in Ashburn, VA"
        width="1000"
        height="1333"
        loading="lazy"
      />
      <figcaption>Server and network work</figcaption>
    </figure>
    <figure>
      <img
        src="/images/gaming-pc.jpg"
        alt="Open desktop gaming PC showing its internal components at AZ Tech Services in Ashburn, VA"
        width="1000"
        height="1333"
        loading="lazy"
      />
      <figcaption>Desktop and gaming PC repairs</figcaption>
    </figure>
    <figure>
      <img
        src="/images/workbench-pc.jpg"
        alt="Open desktop PC on the repair bench at AZ Tech Services in Ashburn, VA"
        width="1320"
        height="990"
