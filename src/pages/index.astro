---
import BaseLayout from "../layouts/BaseLayout.astro";
import { business, serviceAreaText } from "../config.ts";

const localBusiness = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: business.name,
  url: business.siteUrl,
  telephone: business.phone,
  address: {
    "@type": "PostalAddress",
    streetAddress: business.streetAddress,
    addressLocality: business.addressLocality,
    addressRegion: business.addressRegion,
    postalCode: business.postalCode,
    addressCountry: "US",
  },
  openingHours: business.openingHours,
  image: `${business.siteUrl}/images/team-front-desk.webp`,
  logo: `${business.siteUrl}/images/logo.webp`,
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.9",
    reviewCount: "169",
  },
  review: [
    {
      "@type": "Review",
      author: {
        "@type": "Person",
        name: "Ariel Wolfer",
      },
      reviewRating: {
        "@type": "Rating",
        ratingValue: "5",
      },
      reviewBody:
        "Did a great job pinpointing the problem with my PC, and provided a detailed option to fix it, all at reasonable pricing. They earned my confidence in being good faith operators.",
    },
    {
      "@type": "Review",
      author: {
        "@type": "Person",
        name: "Robert Johnson",
      },
      reviewRating: {
        "@type": "Rating",
        ratingValue: "5",
      },
      reviewBody:
        "The guys at AZ Tech were super friendly and completely competent. They quickly confirmed the problem with my laptop, and ordered the right part. When I dropped off the computer after the part arrived, they completed the repair almost faster than I could drive home. I am totally satisfied, and will use AZ Tech again!",
    },
    {
      "@type": "Review",
      author: {
        "@type": "Person",
        name: "Gerald Fry",
      },
      reviewRating: {
        "@type": "Rating",
        ratingValue: "5",
      },
      reviewBody:
        "AZ Tech Services is absolutely the best place to have your tech equipment serviced. I've been using them for 3 years on several very difficult projects and they have come through with great results. Computers iPads and other tech equipment go to AZ Tech Services. Also very reasonable prices for this excellent service. Nothing is too big or small for them to repair.",
    },
  ],
  sameAs: ["https://www.aztechservices.net"],
  areaServed: business.serviceArea.map((place) => ({
    "@type": "City",
    name: place,
  })),
};
---

<BaseLayout
  title="Computer, Laptop & Phone Repair in Ashburn, VA"
  description="Fast, local computer repair in Ashburn, VA — desktops, laptops, virus removal, data recovery, phones, and gaming consoles. Free quotes and walk-ins welcome."
  path="/"
  jsonLd={localBusiness}
>
  <section class="hero">
    <h1>Computer Repair in Ashburn, VA</h1>
    <img
      class="hero-img"
      src="/images/team-front-desk.webp"
      alt="The AZ Tech Services team at the front desk of the Ashburn shop"
      width="1320"
      height="990"
      fetchpriority="high"
    />
    <p class="lede">
      Broken laptop, slow PC, virus, or lost files? {business.name} fixes
      computers for people and businesses in Ashburn — with free quotes, clear
      pricing before any work starts, and no fix, no fuss.
    </p>
    <p>
      Walk in with your device or <a href="/contact">get in touch</a> and we
      will tell you what is wrong, what it costs, and how long it takes —
      before you commit to anything.
    </p>
    <p class="rating">★ 4.9 · 169 Google reviews</p>
    <p class="cta-row">
      <a class="btn btn-primary" href={`tel:${business.phone}`}>
        Call {business.phoneDisplay}
      </a>
      <a class="btn btn-outline" href="/contact">Get a free quote</a>
    </p>
  </section>

  <h2>What we fix</h2>
  <div class="cards">
    <div class="card">
      <svg class="card-icon" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
      <h3><a href="/computer-repair">Computer Repair</a></h3>
      <p>
        Desktop PCs that will not boot, crash, overheat, or have stopped
        keeping up.
      </p>
    </div>
    <div class="card">
      <svg class="card-icon" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="2" y1="17" x2="22" y2="17"></line></svg>
      <h3><a href="/laptop-repair">Laptop Repair</a></h3>
      <p>
        Cracked screens, dead batteries, broken keyboards, charging ports, and
        hinge damage.
      </p>
    </div>
    <div class="card">
      <svg class="card-icon" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10H12V2z"></path><path d="M12 2v10l8.66 5"></path><path d="M12 12 2 7"></path></svg>
      <h3><a href="/virus-removal">Virus Removal</a></h3>
      <p>
        Pop-ups, ransomware scares, browser hijacks, and malware cleaned out
        properly.
      </p>
    </div>
    <div class="card">
      <svg class="card-icon" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
      <h3><a href="/data-recovery">Data Recovery</a></h3>
      <p>
        Photos, documents, and work files recovered from failing drives and
        dead devices.
      </p>
    </div>
    <div class="card">
      <svg class="card-icon" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
      <h3><a href="/phone-repair">Phone Repair</a></h3>
      <p>Screen, battery, and charging repairs for popular phones.</p>
    </div>
    <div class="card">
      <svg class="card-icon" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"></rect><polyline points="17 2 12 7 7 2"></polyline></svg>
      <h3><a href="/gaming-console-repair">Console Repair</a></h3>
      <p>
        PlayStation, Xbox, and Nintendo consoles — HDMI, disc drive, and
        overheating problems.
      </p>
    </div>
  </div>

  <h2>Areas we serve</h2>
  <p>
    Based in Ashburn, we repair devices for customers across {serviceAreaText}.
  </p>

  <h2>Inside the shop</h2>
  <div class="gallery">
    <figure>
      <img
        src="/images/bench.webp"
        alt="Technicians repairing a laptop at the AZ Tech Services workbench in Ashburn, VA"
        width="1400"
        height="1050"
        loading="lazy"
      />
      <figcaption>Our repair bench in Ashburn</figcaption>
    </figure>
    <figure>
      <img
        src="/images/server-rack.webp"
        alt="Server and network rack installed by AZ Tech Services in Ashburn, VA"
        width="1000"
        height="1333"
        loading="lazy"
      />
      <figcaption>Server and network work</figcaption>
    </figure>
    <figure>
      <img
        src="/images/gaming-pc.webp"
        alt="Open desktop gaming PC showing its internal components at AZ Tech Services in Ashburn, VA"
        width="1000"
        height="1333"
        loading="lazy"
      />
      <figcaption>Desktop and gaming PC repairs</figcaption>
    </figure>
    <figure>
      <img
        src="/images/workbench-pc.webp"
        alt="Open desktop PC on the repair bench at AZ Tech Services in Ashburn, VA"
        width="1320"
        height="990"
        loading="lazy"
      />
      <figcaption>Desktop repair on the bench</figcaption>
    </figure>
    <figure>
      <img
        src="/images/team-front-desk.webp"
        alt="The AZ Tech Services team at the front desk of the Ashburn shop"
        width="1320"
        height="990"
        loading="lazy"
      />
      <figcaption>Our team at the front desk</figcaption>
    </figure>
    <figure>
      <img
        src="/images/tech-pc-build.webp"
        alt="Technician working inside a desktop PC at AZ Tech Services in Ashburn, VA"
        width="1000"
        height="1333"
        loading="lazy"
      />
      <figcaption>Desktop PC work</figcaption>
    </figure>
    <figure>
      <img
        src="/images/front-desk.webp"
        alt="Service desk at AZ Tech Services in Ashburn, VA"
        width="1000"
        height="1333"
        loading="lazy"
      />
      <figcaption>The service desk</figcaption>
    </figure>
    <figure>
      <img
        src="/images/phone-repair-bench.webp"
        alt="Technician repairing a phone at the workbench at AZ Tech Services in Ashburn, VA"
        width="1320"
        height="990"
        loading="lazy"
      />
      <figcaption>Phone repair at the bench</figcaption>
    </figure>
    <figure>
      <img
        src="/images/mini-pcs.webp"
        alt="Mini PCs serviced on the bench at AZ Tech Services in Ashburn, VA"
        width="1320"
        height="990"
        loading="lazy"
      />
      <figcaption>Mini PC repairs</figcaption>
    </figure>
    <figure>
      <img
        src="/images/team-logo-wall.webp"
        alt="Team member at the AZ Tech Services counter in Ashburn, VA"
        width="1320"
        height="903"
        loading="lazy"
      />
      <figcaption>At the counter</figcaption>
    </figure>
    <figure>
      <img
        src="/images/techs-bench.webp"
        alt="Technicians working together at the repair bench in Ashburn, VA"
        width="1320"
        height="1304"
        loading="lazy"
      />
      <figcaption>Teamwork on the bench</figcaption>
    </figure>
    <figure>
      <img
        src="/images/team-logo-portrait.webp"
        alt="Team member in front of the AZ Tech logo wall in Ashburn, VA"
        width="1000"
        height="1617"
        loading="lazy"
      />
      <figcaption>In the shop</figcaption>
    </figure>
  </div>

  <h2>Why choose a local Ashburn repair shop?</h2>
  <p>
    You talk to the person actually fixing your device, not a shipping label.
    Diagnosis is explained in plain language, quotes are free, and you approve
    the price before any repair begins. Most common repairs are turned around
    quickly, and if a part has to be ordered, you will know the wait up front.
  </p>

  <h2>What customers say</h2>
  <div class="testimonials">
    <div class="testimonial">
      <div class="stars">★★★★★</div>
      <p class="quote">
        "Did a great job pinpointing the problem with my PC, and provided a
        detailed option to fix it, all at reasonable pricing. They earned my
        confidence in being good faith operators."
      </p>
      <p class="author">— Ariel Wolfer</p>
    </div>
    <div class="testimonial">
      <div class="stars">★★★★★</div>
      <p class="quote">
        "The guys at AZ Tech were super friendly and completely competent. They
        quickly confirmed the problem with my laptop, and ordered the right
        part. When I dropped off the computer after the part arrived, they
        completed the repair almost faster than I could drive home. I am totally
        satisfied, and will use AZ Tech again!"
      </p>
      <p class="author">— Robert Johnson</p>
    </div>
    <div class="testimonial">
      <div class="stars">★★★★★</div>
      <p class="quote">
        "AZ Tech Services is absolutely the best place to have your tech
        equipment serviced. I've been using them for 3 years on several very
        difficult projects and they have come through with great results.
        Computers iPads and other tech equipment go to AZ Tech Services. Also
        very reasonable prices for this excellent service. Nothing is too big or
        small for them to repair."
      </p>
      <p class="author">— Gerald Fry</p>
    </div>
  </div>

  <h2>Serving Ashburn and nearby towns</h2>
  <p>
    We serve customers across {serviceAreaText}. If you are nearby and unsure
    whether your device is worth fixing, bring it in — the diagnosis and quote
    cost nothing.
  </p>

  <h2>Common questions</h2>
  <dl class="faq">
    <dt>How much does computer repair cost in Ashburn?</dt>
    <dd>
      It depends on the fault and the part needed. Quotes are free: we diagnose
      the device first and give you an exact price before any work starts, so
      there are no surprise charges.
    </dd>
    <dt>How long does a repair take?</dt>
    <dd>
      Many common repairs are completed the same day or the next business day.
      Jobs that need ordered parts take longer, and you will get a time
      estimate with your quote.
    </dd>
    <dt>Do I need an appointment?</dt>
    <dd>
      No — walk-ins are welcome every day from 8:30 AM to 2:00 PM. After
      hours, visits are by appointment. See the{" "}
      <a href="/contact">contact page</a> for the address and phone number.
    </dd>
  </dl>
  <p>
    <a href="/faq">See all frequently asked questions →</a>
  </p>
</BaseLayout>
