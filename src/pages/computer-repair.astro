---
import BaseLayout from "../layouts/BaseLayout.astro";
import { business } from "../config.ts";

const faqs = [
  {
    q: "How much does computer repair cost in Ashburn?",
    a: "It depends on the fault and any parts needed. Diagnosis and quotes are free — you get an exact price before any work starts.",
  },
  {
    q: "My PC will not turn on at all. Is it worth fixing?",
    a: "Often, yes. A dead PC is frequently a failed power supply, a loose connection, or a corrupted system — all quick, affordable fixes. Bring it in for a free diagnosis before deciding.",
  },
  {
    q: "How long does a desktop repair take?",
    a: "Many common repairs are done the same day or the next business day. If a part must be ordered, you will get a time estimate with your quote.",
  },
  {
    q: "Will I lose my files?",
    a: "No. Your data is left alone unless the drive itself is the problem, in which case we discuss recovery options with you first.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Computer Repair",
    provider: { "@type": "LocalBusiness", name: business.name, url: business.siteUrl },
    areaServed: business.serviceArea,
    description:
      "Desktop computer repair in Ashburn, VA: PCs that will not boot, crash, overheat, or run slowly.",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Computer Repair in Ashburn, VA"
  description="Desktop computer repair in Ashburn, VA — PCs that won't boot, crash, overheat, or run slowly. Free diagnosis and quote before any work starts."
  path="/computer-repair"
  jsonLd={jsonLd}
>
  <h1>Computer Repair in Ashburn, VA</h1>
  <p class="lede">
    Most desktop problems are fixable the same day or the next business day —
    and a free diagnosis tells you exactly what is wrong and what it costs
    before you spend anything.
  </p>
  <p>
    Whether your PC will not boot, keeps crashing, runs hot and loud, or has
    simply slowed to a crawl, bring it to {business.name} in Ashburn. We find
    the actual fault instead of guessing, and we explain it in plain language.
  </p>

  <h2>What we fix</h2>
  <ul class="fixes">
    <li>PCs that will not turn on or will not boot</li>
    <li>Blue screens, random crashes, and freezes</li>
    <li>Slow startups and sluggish performance</li>
    <li>Overheating, loud fans, and sudden shutdowns</li>
    <li>Failed power supplies, RAM, and hard drives</li>
    <li>Windows errors, failed updates, and login problems</li>
    <li>New PC setup, upgrades, and data transfers</li>
  </ul>

  <h2>How a repair works</h2>
  <ol class="steps">
    <li>Bring in your PC (or just the tower) — walk-ins welcome.</li>
    <li>We diagnose the fault and explain what is wrong.</li>
    <li>You get an exact quote. Nothing starts until you approve it.</li>
    <li>We repair, test, and let you know when it is ready to collect.</li>
  </ol>

  <div class="callout">
    <p>
      <strong>Pricing:</strong> quotes are free and the exact price depends on
      the diagnosis and any parts needed. You approve the price before work
      begins — no surprise charges.
    </p>
  </div>

  <h2>Frequently asked questions</h2>
  <dl class="faq">
    {
      faqs.map((f) => (
        <>
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </>
      ))
    }
  </dl>
  <p>
    <a href="/contact">Contact us</a> or see our <a href="/faq">general FAQ</a>.
  </p>
</BaseLayout>
