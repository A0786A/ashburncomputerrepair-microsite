---
import BaseLayout from "../layouts/BaseLayout.astro";
import { business } from "../config.ts";

const faqs = [
  {
    q: "How much does a phone screen replacement cost in Ashburn?",
    a: "It depends on the phone model and screen type. Diagnosis and quotes are free — you get an exact price before any work starts.",
  },
  {
    q: "My phone battery drains fast. Is it worth replacing?",
    a: "Yes, in most cases. A fresh battery usually restores normal battery life and is much cheaper than replacing the phone.",
  },
  {
    q: "My phone got wet. What should I do?",
    a: "Turn it off, do not charge it, and do not try to dry it with heat. Bring it in as soon as possible — the sooner it is checked, the better the chances.",
  },
  {
    q: "Will I lose my photos if my phone is repaired?",
    a: "No, for standard screen, battery, and charging repairs your data is untouched. If the phone will not turn on, we discuss data options with you first.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Phone Repair",
    provider: { "@type": "LocalBusiness", name: business.name, url: business.siteUrl },
    areaServed: business.serviceArea,
    description:
      "Phone repair in Ashburn, VA: cracked screens, battery replacement, charging port repair, and water-damaged phones.",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Phone Repair in Ashburn, VA"
  description="Phone repair in Ashburn, VA — cracked screens, battery replacement, charging port repair, and water-damaged phones. Free diagnosis and quote."
  path="/phone-repair"
  jsonLd={jsonLd}
>
  <h1>Phone Repair in Ashburn, VA</h1>
  <p class="lede">
    Cracked screen, dying battery, or a phone that will not charge? Most phone
    repairs are quick — and a free diagnosis gives you the exact price before
    you commit.
  </p>
  <p>
    {business.name} in Ashburn repairs popular phones for walk-in customers.
    Bring the phone and its charger if you have it.
  </p>

  <h2>What we fix</h2>
  <ul class="fixes">
    <li>Cracked and unresponsive phone screens</li>
    <li>Batteries that drain fast or will not hold a charge</li>
    <li>Charging ports and phones that will not charge</li>
    <li>Broken back glass and buttons</li>
    <li>Water-damaged phones (bring it in as soon as possible)</li>
    <li>Speaker, microphone, and camera problems</li>
  </ul>

  <div class="callout cta-mid">
    <p class="cta-row">
      <a class="btn btn-primary" href={`tel:${business.phone}`}>
        Call {business.phoneDisplay}
      </a>
    </p>
    <p>
      Walk-ins welcome every day 8:30 AM to 2:00 PM · After-hours by appointment
    </p>
  </div>

  <h2>How a repair works</h2>
  <ol class="steps">
    <li>Bring in your phone — walk-ins welcome.</li>
    <li>We diagnose the fault and explain what is wrong.</li>
    <li>You get an exact quote. Nothing starts until you approve it.</li>
    <li>We repair, test, and let you know when it is ready to collect.</li>
  </ol>

  <div class="callout">
    <p>
      <strong>Pricing:</strong> quotes are free and the exact price depends on
      the diagnosis and the part needed — screen and battery prices vary by
      model. You approve the price before work begins.
    </p>
  </div>

  <h2>Frequently asked questions</h2>
  <dl class="faq">
    {
      faqs.map((f) => (
        <>
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </>
      ))
    }
  </dl>
  <p>
    <a href="/contact">Contact us</a> or see our <a href="/faq">general FAQ</a>.
  </p>
</BaseLayout>
