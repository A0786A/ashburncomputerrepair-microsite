---
import BaseLayout from "../layouts/BaseLayout.astro";
import { business } from "../config.ts";

const faqs = [
  {
    q: "How much does a PS5 HDMI port repair cost?",
    a: "It depends on the console model and the extent of the damage. Diagnosis and quotes are free — you get an exact price before any work starts.",
  },
  {
    q: "My console overheats and shuts off. Can it be fixed?",
    a: "Often, yes. Overheating is commonly caused by dust buildup, dried thermal paste, or a failing fan — all repairable.",
  },
  {
    q: "My console will not read discs. Is the drive dead?",
    a: "Not always. It can be a dirty lens, a worn drive, or a software issue. We test it during the free diagnosis before recommending a repair.",
  },
  {
    q: "Do you repair Nintendo Switch Joy-Con drift?",
    a: "Yes. Stick drift is a common, fixable problem, and controllers are usually turned around quickly.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Gaming Console Repair",
    provider: { "@type": "LocalBusiness", name: business.name, url: business.siteUrl },
    areaServed: business.serviceArea,
    description:
      "Gaming console repair in Ashburn, VA: PlayStation, Xbox, and Nintendo Switch — HDMI ports, disc drives, overheating, and controller drift.",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Gaming Console Repair in Ashburn, VA"
  description="Gaming console repair in Ashburn, VA — PlayStation, Xbox, and Nintendo Switch: HDMI ports, disc drives, overheating, and controller drift. Free diagnosis and quote."
  path="/gaming-console-repair"
  jsonLd={jsonLd}
>
  <h1>Gaming Console Repair in Ashburn, VA</h1>
  <p class="lede">
    No signal, disc read errors, overheating shutdowns, or drifting sticks?
    Most console problems are repairable — and a free diagnosis tells you the
    exact cost before you commit.
  </p>
  <p>
    {business.name} in Ashburn repairs PlayStation, Xbox, and Nintendo
    consoles and controllers. Bring the console and its power cable; for disc
    problems, bring a disc that fails to read.
  </p>

  <h2>What we fix</h2>
  <ul class="fixes">
    <li>HDMI ports with no signal or a loose connection</li>
    <li>Disc drives that will not read or eject discs</li>
    <li>Overheating, loud fans, and sudden shutdowns</li>
    <li>Consoles that will not turn on</li>
    <li>Controller stick drift and broken buttons</li>
    <li>Storage upgrades and system software problems</li>
  </ul>

  <div class="callout cta-mid">
    <p class="cta-row">
      <a class="btn btn-primary" href={`tel:${business.phone}`}>
        Call {business.phoneDisplay}
      </a>
    </p>
    <p>
      Walk-ins welcome every day 8:30 AM to 2:00 PM · After-hours by appointment
    </p>
  </div>

  <h2>How a repair works</h2>
  <ol class="steps">
    <li>Bring in your console — walk-ins welcome.</li>
    <li>We diagnose the fault and explain what is wrong.</li>
    <li>You get an exact quote. Nothing starts until you approve it.</li>
    <li>We repair, test, and let you know when it is ready to collect.</li>
  </ol>

  <div class="callout">
    <p>
      <strong>Pricing:</strong> quotes are free and the exact price depends on
      the diagnosis and any parts needed. You approve the price before work
      begins.
    </p>
  </div>

  <h2>Frequently asked questions</h2>
  <dl class="faq">
    {
      faqs.map((f) => (
        <>
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </>
      ))
    }
  </dl>
  <p>
    <a href="/contact">Contact us</a> or see our <a href="/faq">general FAQ</a>.
  </p>
</BaseLayout>
