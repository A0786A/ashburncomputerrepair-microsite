---
import BaseLayout from "../layouts/BaseLayout.astro";
import { business, serviceAreaText } from "../config.ts";
---

<BaseLayout
  title="Contact"
  description="Contact AZ Tech Services — computer, laptop, phone, and gaming console repair serving Ashburn, VA and nearby towns."
  path="/contact"
>
  <h1>Contact {business.name}</h1>
  <p class="lede">
    We repair computers, laptops, phones, and gaming consoles for customers in{" "}
    {business.city} and nearby towns.
  </p>

  <h2>Service area</h2>
  <p>{serviceAreaText}.</p>

  <h2>Visit the shop</h2>
  <p>{business.fullAddress}</p>
  <img
    class="hero-img"
    src="/images/team-front-desk.jpg"
    alt="The AZ Tech Services team at the front desk of the Ashburn shop"
    width="1320"
    height="990"
    loading="lazy"
  />

  <h2>Call us</h2>
  <p>
    <a href={`tel:${business.phone}`}>{business.phoneDisplay}</a>
  </p>

  <h2>Hours</h2>
  <p>{business.hoursDisplay}</p>

  <div class="callout">
    <p>
      Walk-ins are welcome during walk-in hours, and every diagnosis and
      quote is free.
    </p>
  </div>

  <h2>What to bring</h2>
  <ul class="fixes">
    <li>The device itself, plus its charger or power cable if you have it</li>
    <li>For disc problems, a disc that fails to read</li>
    <li>Your device password or PIN, if the repair needs it (you can also set
      a temporary one)</li>
  </ul>
</BaseLayout>
